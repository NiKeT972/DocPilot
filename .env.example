# DocPilot configuration. Copy to `.env` for local dev (never commit `.env`).
# On Vercel, add these in Project Settings -> Environment Variables.

# --- Required -------------------------------------------------------------
# Groq: LLMs for answering, grading, rewriting. https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio: embeddings (gemini-embedding-001) + OCR for scanned pages.
GEMINI_API_KEY=

# --- Optional -------------------------------------------------------------
# Tavily web search. Leave empty to disable web fallback (UI shows it as off).
TAVILY_API_KEY=

# Supabase (Postgres + pgvector). Leave empty locally to use the in-memory store.
# REQUIRED on Vercel (the app refuses to start without it there).
SUPABASE_URL=
# Service-role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_KEY=

# --- Models (check https://api.groq.com/openai/v1/models for what's live) --
ANSWER_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
EMBED_MODEL=gemini-embedding-001
# Must match vector(768) in supabase/schema.sql.
EMBED_DIM=768
# Gemini vision model used to OCR scanned pages.
OCR_MODEL=gemini-3.5-flash-lite

# --- Retrieval / chunking --------------------------------------------------
# Passages kept after hybrid (vector + full-text) fusion.
TOP_K=6
# Candidates taken from each of vector and full-text search before RRF.
CANDIDATE_K=8
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Limits (enforced on the server) ----------------------------------------
MAX_PDF_MB=50
MAX_PAGES=1000
MAX_FILES_PER_SESSION=10
MAX_PAGES_PER_SESSION=2000
MAX_OCR_PAGES_PER_FILE=30

# --- Rate limits per IP ------------------------------------------------------
RATE_CHAT_PER_HOUR=30
RATE_INGEST_PER_DAY=300
RATE_OCR_PER_DAY=40

# --- Security / ops ------------------------------------------------------------
# Random secret used to hash client IPs (required on Vercel). e.g. `openssl rand -hex 32`
IP_HASH_SALT=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/cleanup.
CRON_SECRET=
# Delete documents/chunks older than this many days.
RETENTION_DAYS=7
